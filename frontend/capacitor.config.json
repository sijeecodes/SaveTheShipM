{
  "appId": "com.savetheship.app",
  "appName": "Save The Ship",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "preferredContentMode": "mobile"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "ScreenOrientation": {
      "orientation": "landscape"
    }
  }
}
